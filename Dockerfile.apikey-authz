# syntax=docker/dockerfile:1
# ── Stage 1: Build ────────────────────────────────────────────────
FROM mcr.microsoft.com/oss/go/microsoft/golang:1.27@sha256:7a193a3f8ee2ffc8c1420affd7e13cfee4e5d1291a54b1dee370ee1ea3b5241a AS builder
WORKDIR /workspace

# Cache module downloads separately from source.
COPY go.mod go.sum ./
RUN go mod download

# Copy source and build the apikey-authz binary.
COPY . .
RUN GOOS=linux go build \
      -ldflags="-s -w" \
      -o /out/apikey-authz \
      ./cmd/apikey-authz/

# ── Stage 2: Runtime ──────────────────────────────────────────────
# Microsoft Go's crypto backend requires CGO, producing a dynamically-linked
# binary that needs glibc at runtime. The "minimal" distroless image strips
# glibc, so we use "base" (which includes glibc + libssl).
FROM mcr.microsoft.com/azurelinux/distroless/base:3.0@sha256:370fb2c55e7f0474fed019623cce6a8db65a4d70dedfca9219fc69d6c7627f89
COPY --from=builder /out/apikey-authz /apikey-authz
USER 65532:65532
EXPOSE 8082 8083 9001
ENTRYPOINT ["/apikey-authz"]
