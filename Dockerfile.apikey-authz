# syntax=docker/dockerfile:1
# ── Stage 1: Build ────────────────────────────────────────────────
FROM mcr.microsoft.com/oss/go/microsoft/golang:1.25 AS builder
WORKDIR /workspace

# Cache module downloads separately from source.
COPY go.mod go.sum ./
RUN go mod download

# Copy source and build the apikey-authz binary.
COPY . .
RUN GOOS=linux go build \
      -ldflags="-s -w" \
      -o /out/apikey-authz \
      ./cmd/apikey-authz/

# ── Stage 2: Runtime ──────────────────────────────────────────────
# Microsoft Go's crypto backend requires CGO, producing a dynamically-linked
# binary. The "base" distroless image includes glibc (unlike "minimal").
FROM mcr.microsoft.com/azurelinux/distroless/base:3.0@sha256:778234268d70523855c488a9324abd1bf292e7ecf7b8060bb8a15395c18c7690
COPY --from=builder /out/apikey-authz /apikey-authz
USER 65532:65532
EXPOSE 8082 8083 9001
ENTRYPOINT ["/apikey-authz"]
