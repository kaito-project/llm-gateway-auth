# deploy/aks.env — operator-editable configuration for AKS deployment.
# All values can be overridden by environment variables.
# Sourced by: deploy/setup-aks.sh, deploy/teardown-aks.sh
USER=${USER:-$(whoami)}
# Azure resource group and region
RESOURCE_GROUP="${RESOURCE_GROUP:-llm-gateway-rg}"
LOCATION="${LOCATION:-australiaeast}"

# AKS cluster
CLUSTER_NAME="${CLUSTER_NAME:-llm-gateway-aks}"
NODE_COUNT="${NODE_COUNT:-3}"
NODE_VM_SIZE="${NODE_VM_SIZE:-Standard_D4s_v3}"

# Network policy engine (cilium required for NetworkPolicy enforcement)
NETWORK_DATAPLANE="${NETWORK_DATAPLANE:-cilium}"

# Azure Container Registry (must be globally unique, alphanumeric only)
ACR_NAME="${ACR_NAME:-${USER}llmgatewayacr}"

# AKS Istio add-on revision (must match what AKS supports in the region)
ASM_REVISION="${ASM_REVISION:-asm-1-28}"

# Kubernetes namespaces
EXTAUTHZ_NAMESPACE="${EXTAUTHZ_NAMESPACE:-llm-gateway}"
BOOKINFO_NAMESPACE="${BOOKINFO_NAMESPACE:-bookinfo}"

# BookInfo source (pinned to Istio version from versions.env)
ISTIO_VERSION="${ISTIO_VERSION:-1.28.0}"

# Azure AD / Entra ID tenant ID for JWT validation.
# The RequestAuthentication will validate tokens issued by this tenant.
AZURE_AD_TENANT_ID="${AZURE_AD_TENANT_ID:-72f988bf-86f1-41af-91ab-2d7cd011db47}"
