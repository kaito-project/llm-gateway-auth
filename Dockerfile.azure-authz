# syntax=docker/dockerfile:1
# ── Stage 1: Build ────────────────────────────────────────────────
FROM mcr.microsoft.com/oss/go/microsoft/golang:1.26 AS builder
WORKDIR /workspace

# Cache module downloads separately from source.
COPY go.mod go.sum ./
RUN go mod download

# Copy source and build the azure-authz binary.
COPY . .
RUN GOOS=linux go build \
      -ldflags="-s -w" \
      -o /out/azure-authz \
      ./cmd/azure-authz/

# ── Stage 2: Runtime ──────────────────────────────────────────────
# Microsoft Go's crypto backend requires CGO, producing a dynamically-linked
# binary that needs glibc at runtime. The "minimal" distroless image strips
# glibc, so we use "base" (which includes glibc + libssl).
FROM mcr.microsoft.com/azurelinux/distroless/base:3.0
COPY --from=builder /out/azure-authz /azure-authz
USER 65532:65532
EXPOSE 9001 9090
ENTRYPOINT ["/azure-authz"]
