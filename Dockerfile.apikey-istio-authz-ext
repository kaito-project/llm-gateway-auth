# syntax=docker/dockerfile:1
# ── Stage 1: Build ────────────────────────────────────────────────
FROM mcr.microsoft.com/oss/go/microsoft/golang:1.25 AS builder
WORKDIR /workspace

# Cache module downloads separately from source.
COPY go.mod go.sum ./
RUN go mod download

# Copy source and build the apikey-istio-authz-ext binary.
COPY . .
RUN GOOS=linux go build \
      -ldflags="-s -w" \
      -o /out/apikey-istio-authz-ext \
      ./cmd/apikey-istio-authz-ext/

# ── Stage 2: Runtime ──────────────────────────────────────────────
# Microsoft Go's crypto backend requires CGO, producing a dynamically-linked
# binary. The "base" distroless image includes glibc (unlike "minimal").
FROM mcr.microsoft.com/azurelinux/distroless/base:3.0
COPY --from=builder /out/apikey-istio-authz-ext /apikey-istio-authz-ext
USER 65532:65532
EXPOSE 8082 8083 9001
ENTRYPOINT ["/apikey-istio-authz-ext"]
