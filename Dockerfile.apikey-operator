# syntax=docker/dockerfile:1
# ── Stage 1: Build ────────────────────────────────────────────────
FROM golang:1.25.0 AS builder
WORKDIR /workspace

# Cache module downloads separately from source.
COPY go.mod go.sum ./
RUN go mod download

# Copy source and build the apikey-operator binary.
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build \
      -ldflags="-s -w" \
      -o /out/apikey-operator \
      ./cmd/apikey-operator/

# ── Stage 2: Runtime ──────────────────────────────────────────────
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /out/apikey-operator /apikey-operator
USER nonroot:nonroot
EXPOSE 8080 8081 9443
ENTRYPOINT ["/apikey-operator"]
