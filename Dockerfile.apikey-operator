# syntax=docker/dockerfile:1
# ── Stage 1: Build ────────────────────────────────────────────────
FROM mcr.microsoft.com/oss/go/microsoft/golang:1.27@sha256:c1fd7cad39f3f1e669cab9f9905bc0abbc3557c338065f43daa49940f6b99559 AS builder
WORKDIR /workspace

# Cache module downloads separately from source.
COPY go.mod go.sum ./
RUN go mod download

# Copy source and build the apikey-operator binary.
COPY . .
RUN GOOS=linux go build \
      -ldflags="-s -w" \
      -o /out/apikey-operator \
      ./cmd/apikey-operator/

# ── Stage 2: Runtime ──────────────────────────────────────────────
# Microsoft Go's crypto backend requires CGO, producing a dynamically-linked
# binary that needs glibc at runtime. The "minimal" distroless image strips
# glibc, so we use "base" (which includes glibc + libssl).
FROM mcr.microsoft.com/azurelinux/distroless/base:3.0@sha256:6b85a86416a29cdcfd404e9fbd9c5ef49cc0612882cecc702535dcac39c9446c
COPY --from=builder /out/apikey-operator /apikey-operator
USER 65532:65532
EXPOSE 8080 8081 9443
ENTRYPOINT ["/apikey-operator"]
