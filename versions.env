# versions.env
#
# Single source of truth for pinned tool versions.
# Sourced by: hack/setup-test-env.sh, Makefile, .github/workflows/e2e-test.yml
#
# Format: KEY=VALUE (no spaces around '=', no 'export', no quotes).
# This keeps it compatible with shell source, Make include, and GitHub Actions.

KIND_VERSION=0.31.0
ISTIO_VERSION=1.28.0
KIND_NODE_IMAGE=kindest/node:v1.32.0
GO_VERSION=1.25.0
